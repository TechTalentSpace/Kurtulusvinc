---
import company from '@/data/company.json';
import CraneSvg from './CraneSvg.astro';
---
<section
  id="hero"
  class="grid-lines relative isolate h-svh min-h-[560px] overflow-hidden bg-ink"
  aria-label="Tanıtım"
>
  <div class="pointer-events-none absolute inset-x-0 top-0 h-40 bg-gradient-to-b from-ink to-transparent" aria-hidden="true"></div>
  <div class="pointer-events-none absolute -right-24 top-24 h-72 w-72 rounded-full bg-crane/10 blur-3xl" aria-hidden="true"></div>

  <div class="container-x flex h-full flex-col pt-20 pb-[calc(var(--spacing-cta)+2.5rem)] md:grid md:pb-[var(--spacing-cta)] md:grid-cols-12 md:items-center md:gap-8 md:pt-16">
    <div class="md:col-span-5">
      <p class="mb-3 inline-flex items-center gap-2 text-xs font-bold uppercase tracking-[0.2em] text-crane">
        <span class="hazard-stripe inline-block h-2 w-8 rounded-sm" aria-hidden="true"></span>
        Bom uzuyor, hizmet açılıyor
      </p>
      <h1 class="text-[2.35rem] font-extrabold leading-[1.02] text-white sm:text-5xl lg:text-[3.4rem]">
        Çeşme &amp; Alaçatı<br />
        <span class="text-crane">Vinç Kiralama</span>
      </h1>
      <p class="mt-4 max-w-md text-base text-fog sm:text-lg">
        Mobil vinç, sepetli platform ve hiyap nakliye. Operatörlü, yarımadanın her noktasına hızlı ulaşım.
      </p>
      <p class="mt-3 text-sm text-fog-2">{company.areaLabel} · <a class="font-semibold text-fog underline-offset-4 hover:text-crane hover:underline" href={`tel:${company.phoneE164}`}>{company.phoneDisplay}</a></p>
    </div>

    <div class="relative mt-2 flex flex-1 flex-col justify-center md:col-span-7 md:mt-0">
      <div class="relative -ml-[12%] w-[124%] md:mx-auto md:w-full md:max-w-[720px]" style="aspect-ratio: 1000 / 700;">
        <CraneSvg />
        <a
          data-hero-cta
          href={`tel:${company.phoneE164}`}
          class="tap absolute right-[14%] top-[45%] md:right-0 inline-flex items-center gap-2 rounded-full bg-crane px-6 py-3 text-base font-extrabold text-ink shadow-[0_10px_40px_-10px_rgba(245,179,1,.6)] active:scale-[.98]"
          style="will-change: transform, opacity"
        >
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M22 16.9v3a2 2 0 0 1-2.2 2 19.8 19.8 0 0 1-8.6-3.1 19.5 19.5 0 0 1-6-6A19.8 19.8 0 0 1 2.1 4.2 2 2 0 0 1 4.1 2h3a2 2 0 0 1 2 1.7c.1.9.4 1.9.7 2.8a2 2 0 0 1-.5 2.1L8 9.9a16 16 0 0 0 6 6l1.3-1.3a2 2 0 0 1 2.1-.4c.9.3 1.8.6 2.8.7a2 2 0 0 1 1.8 2z"/></svg>
          Hemen Ara
        </a>
      </div>
    </div>
  </div>

  <div data-scroll-hint class="pointer-events-none absolute inset-x-0 bottom-[calc(var(--spacing-cta)+env(safe-area-inset-bottom,0px)+0.75rem)] flex flex-col items-center gap-1 text-[11px] font-semibold uppercase tracking-[0.2em] text-fog-2 transition-opacity duration-500">
    <span>Aşağı kaydır</span>
    <svg class="scroll-hint" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 5v14M5 12l7 7 7-7"/></svg>
  </div>
</section>

<script>
  import { initHero } from '@/scripts/hero';
  // GSAP'ı ana iş parçacığı boşaldığında yükle (client:idle eşdeğeri)
  const start = () => initHero();
  if ('requestIdleCallback' in window) requestIdleCallback(start, { timeout: 1500 });
  else setTimeout(start, 200);
</script>
