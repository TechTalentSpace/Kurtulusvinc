---
/**
 * Hero: gerçek vinç fotoğrafı, scroll ile pinlenir; fotoğraf yaklaşır ve kayar,
 * başlık yukarı süzülür, CTA yerine oturur. Yalnızca transform/opacity.
 * Fotoğrafı değiştirmek için: src/assets/hero-crane.jpg (bkz. scripts/hero-photo.mjs)
 */
import { Picture } from 'astro:assets';
import company from '@/data/company.json';
import hero from '@/assets/hero-crane.jpg';
---
<section id="hero" class="relative isolate h-svh min-h-[600px] overflow-hidden bg-ink" aria-label="Tanıtım">
  <!-- fotoğraf katmanı -->
  <div data-hero-photo class="absolute inset-0 -z-10 scale-[1.06]">
    <Picture
      src={hero}
      formats={['avif', 'webp']}
      widths={[480, 768, 1024]}
      sizes="100vw"
      alt="Beyaz MAN şasi üzerinde teleskopik bomlu vinçli kamyon, bulutlu gökyüzü altında yolda"
      loading="eager"
      fetchpriority="high"
      decoding="async"
      pictureAttributes={{ class: 'block h-full w-full' }}
    />
  </div>
  <!-- ton katmanları -->
  <div class="pointer-events-none absolute inset-0 -z-10 bg-gradient-to-b from-ink/85 via-ink/30 to-ink" aria-hidden="true"></div>
  <div data-hero-shade class="pointer-events-none absolute inset-0 -z-10 bg-ink/0" aria-hidden="true"></div>
  <div class="pointer-events-none absolute inset-x-0 bottom-0 -z-10 h-1/2 bg-gradient-to-t from-ink via-ink/70 to-transparent" aria-hidden="true"></div>

  <div class="container-x flex h-full flex-col justify-end pb-[calc(var(--spacing-cta)+2rem)] pt-20 md:justify-center md:pb-[var(--spacing-cta)]">
    <div data-hero-text class="max-w-xl">
      <p class="mb-4 flex items-center gap-3 text-[11px] font-semibold uppercase tracking-[0.28em] text-crane">
        <span class="hazard-stripe inline-block h-px w-10" aria-hidden="true"></span>
        Çeşme · Alaçatı · Yarımada
      </p>
      <h1 class="text-[2.6rem] font-semibold leading-[1.02] tracking-[-0.03em] text-white sm:text-6xl">
        Vinç lazım.<br />
        <span class="text-crane">Biz yoldayız.</span>
      </h1>
      <p class="mt-5 max-w-md text-[15px] leading-relaxed text-fog/90 sm:text-lg">
        Operatörlü mobil vinç, sepetli platform ve hiyap nakliye. Çeşme, Alaçatı ve tüm yarımada. Konumu atın, ekip yola çıksın.
      </p>
      <div data-hero-cta class="mt-7 flex flex-col gap-3 sm:flex-row">
        <a href={`tel:${company.phoneE164}`} class="tap inline-flex items-center justify-center gap-2 rounded-full bg-crane px-7 py-3.5 text-base font-bold tracking-wide text-ink shadow-[0_18px_50px_-18px_rgba(201,169,97,.7)] active:scale-[.98]">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M22 16.9v3a2 2 0 0 1-2.2 2 19.8 19.8 0 0 1-8.6-3.1 19.5 19.5 0 0 1-6-6A19.8 19.8 0 0 1 2.1 4.2 2 2 0 0 1 4.1 2h3a2 2 0 0 1 2 1.7c.1.9.4 1.9.7 2.8a2 2 0 0 1-.5 2.1L8 9.9a16 16 0 0 0 6 6l1.3-1.3a2 2 0 0 1 2.1-.4c.9.3 1.8.6 2.8.7a2 2 0 0 1 1.8 2z"/></svg>
          {company.phoneDisplay}
        </a>
        <a href={company.whatsapp} target="_blank" rel="noopener" class="tap inline-flex items-center justify-center gap-2 rounded-full border border-fog/25 px-7 py-3.5 text-base font-semibold text-fog backdrop-blur-sm active:bg-white/10">
          Konum gönder
        </a>
      </div>
    </div>
  </div>

  <div data-scroll-hint class="pointer-events-none absolute inset-x-0 bottom-[calc(var(--spacing-cta)+env(safe-area-inset-bottom,0px)+0.5rem)] flex flex-col items-center gap-1 text-[10px] font-semibold uppercase tracking-[0.25em] text-fog-2/70 transition-opacity duration-500">
    <svg class="scroll-hint" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 5v14M5 12l7 7 7-7"/></svg>
  </div>
</section>

<script>
  import { initHero } from '@/scripts/hero';
  const start = () => initHero();
  if ('requestIdleCallback' in window) requestIdleCallback(start, { timeout: 1500 });
  else setTimeout(start, 200);
</script>
