---
/**
 * Hero: arka planı kaldırılmış GERÇEK vinç fotoğrafı, katmanlı.
 * Katmanlar aynı tuvalde (1100×2080) şeffaf PNG → astro:assets WebP.
 *   carrier: şasi + taban bom (üstte)  |  boom2: 2. teleskopik bölüm
 *   boom3: 3. bölüm + bom başı         |  hook: kanca bloğu
 * Scroll ile boom2 ve boom3 bom ekseninde uzar, kanca iner ve CTA'yı "kaldırır".
 * Yeni fotoğraf için: scripts/crane-layers.py
 */
import { Image } from 'astro:assets';
import company from '@/data/company.json';
import carrier from '@/assets/crane/carrier.png';
import boom2 from '@/assets/crane/boom2.png';
import boom3 from '@/assets/crane/boom3.png';
import hook from '@/assets/crane/hook.png';

const layerCls = 'absolute inset-0 h-full w-full object-contain select-none pointer-events-none';
import { HERO_WIDTHS as widths, HERO_SIZES as sizes, HERO_QUALITY } from '@/scripts/hero-assets';
---
<section id="hero" class="relative isolate h-svh min-h-[620px] overflow-hidden bg-ink" aria-label="Tanıtım">
  <div class="grid-lines pointer-events-none absolute inset-0 -z-10 opacity-60 [mask-image:radial-gradient(70%_60%_at_70%_55%,#000,transparent)]" aria-hidden="true"></div>
  <div class="pointer-events-none absolute right-[-10%] top-[30%] -z-10 h-[60%] w-[70%] rounded-full bg-crane/10 blur-3xl" aria-hidden="true"></div>

  <div class="container-x relative h-full pt-16 md:grid md:grid-cols-12 md:items-end md:gap-6">
    <!-- metin -->
    <div data-hero-text class="relative z-10 max-w-xs pt-6 md:col-span-5 md:max-w-lg md:self-center md:pt-0">
      <p class="mb-3 flex items-center gap-3 text-[11px] font-semibold uppercase tracking-[0.28em] text-crane">
        <span class="hazard-stripe inline-block h-px w-8" aria-hidden="true"></span>
        Çeşme · Alaçatı
      </p>
      <h1 class="text-[2.5rem] font-semibold leading-[1.02] tracking-[-0.03em] text-white sm:text-6xl">
        Vinç lazım.<br />
        <span class="text-crane">Biz yoldayız.</span>
      </h1>
      <p class="mt-4 max-w-[17rem] text-[15px] leading-relaxed text-fog/85 sm:max-w-md sm:text-lg">
        Operatörlü mobil vinç, sepetli platform ve hiyap. Konumu atın, yarımadanın her yerine yola çıkalım.
      </p>
      <a href={`tel:${company.phoneE164}`} class="tap mt-5 hidden items-center gap-2 text-lg font-semibold text-white underline-offset-4 hover:text-crane hover:underline md:inline-flex">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#c9a961" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M22 16.9v3a2 2 0 0 1-2.2 2 19.8 19.8 0 0 1-8.6-3.1 19.5 19.5 0 0 1-6-6A19.8 19.8 0 0 1 2.1 4.2 2 2 0 0 1 4.1 2h3a2 2 0 0 1 2 1.7c.1.9.4 1.9.7 2.8a2 2 0 0 1-.5 2.1L8 9.9a16 16 0 0 0 6 6l1.3-1.3a2 2 0 0 1 2.1-.4c.9.3 1.8.6 2.8.7a2 2 0 0 1 1.8 2z"/></svg>
        {company.phoneDisplay}
      </a>
    </div>

    <!-- vinç tuvali -->
    <div class="pointer-events-none absolute inset-x-0 bottom-[calc(var(--spacing-cta)+0.5rem)] top-16 md:static md:col-span-7 md:mb-[calc(var(--spacing-cta)+0.75rem)] md:h-[calc(100svh-var(--spacing-cta)-5.5rem)]">
      <div data-crane class="relative ml-auto h-full" style="aspect-ratio: 1100 / 2080; max-width: 100%;">
        <div class="absolute inset-x-[8%] bottom-[1%] h-[4%] rounded-[50%] bg-black/60 blur-xl" aria-hidden="true"></div>
        <div data-cable-wrap class="absolute inset-0" aria-hidden="true">
          <div data-cable class="absolute w-[2px] origin-top bg-fog-2/80" style="left: 8.7%; top: 7.2%; height: 3.4%;"></div>
        </div>
        <Image data-layer="hook" src={hook} widths={widths} sizes={sizes} quality={HERO_QUALITY} alt="" loading="eager" decoding="async" class={layerCls} />
        <Image data-layer="boom3" src={boom3} widths={widths} sizes={sizes} quality={HERO_QUALITY} alt="" loading="eager" decoding="async" class={layerCls} />
        <Image data-layer="boom2" src={boom2} widths={widths} sizes={sizes} quality={HERO_QUALITY} alt="" loading="eager" decoding="async" class={layerCls} />
        <!-- kancanın kaldırdığı CTA -->
        <a
          data-hero-cta
          href={`tel:${company.phoneE164}`}
          class="tap pointer-events-auto absolute left-[2%] z-10 inline-flex items-center gap-2 rounded-full bg-crane px-6 py-3.5 text-base font-bold tracking-wide text-ink shadow-[0_18px_50px_-18px_rgba(201,169,97,.8)] active:scale-[.98]"
          style="top: 53%;"
        >
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M22 16.9v3a2 2 0 0 1-2.2 2 19.8 19.8 0 0 1-8.6-3.1 19.5 19.5 0 0 1-6-6A19.8 19.8 0 0 1 2.1 4.2 2 2 0 0 1 4.1 2h3a2 2 0 0 1 2 1.7c.1.9.4 1.9.7 2.8a2 2 0 0 1-.5 2.1L8 9.9a16 16 0 0 0 6 6l1.3-1.3a2 2 0 0 1 2.1-.4c.9.3 1.8.6 2.8.7a2 2 0 0 1 1.8 2z"/></svg>
          Hemen Ara
        </a>
        <Image data-layer="carrier" src={carrier} widths={widths} sizes={sizes} quality={HERO_QUALITY} alt="Teleskopik bomlu mobil vinç, bom scroll ile uzar" loading="eager" fetchpriority="high" decoding="async" class={layerCls} />
      </div>
    </div>

  </div>

  <div data-scroll-hint class="pointer-events-none absolute inset-x-0 bottom-[calc(var(--spacing-cta)+env(safe-area-inset-bottom,0px)+0.4rem)] flex justify-center text-fog-2/70 transition-opacity duration-500" aria-hidden="true">
    <svg class="scroll-hint" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 5v14M5 12l7 7 7-7"/></svg>
  </div>
</section>

<script>
  import { initHero } from '@/scripts/hero';
  const start = () => initHero();
  if ('requestIdleCallback' in window) requestIdleCallback(start, { timeout: 1200 });
  else setTimeout(start, 200);
</script>
