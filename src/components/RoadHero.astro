---
/**
 * "Yol" hero'su: gerçek Kurtuluş kamyonu (arka planı kaldırılmış) ekranın altında durur;
 * scroll ile durak şeridi ([data-track]) sola akar, tekerlekler mesafeyle döner, yol çizgisi kayar.
 * Her durak gerçek bir iş fotoğrafı + kısa hikâye. Son durak: "Neredesiniz?" + CTA.
 * JS yoksa şerit yatay kaydırılabilir (scroll-snap), hero pinlenmez.
 * Varlıklar: scripts/truck-layers.py → src/assets/truck/
 */
import { Image } from 'astro:assets';
import company from '@/data/company.json';
import truck from '@/assets/truck/truck.png';
import wT1 from '@/assets/truck/wheel-t1.png';
import wT2 from '@/assets/truck/wheel-t2.png';
import wT3 from '@/assets/truck/wheel-t3.png';
import wR from '@/assets/truck/wheel-r.png';
import wF from '@/assets/truck/wheel-f.png';
import pYat from '@/assets/isler/yat-nakliyesi-gece.webp';
import pKonteyner from '@/assets/isler/konteyner-ev-tasima.webp';
import pFilika from '@/assets/isler/filika-tekne-yukleme.webp';
import pZeytin from '@/assets/isler/zeytin-agaci-nakli.webp';
import pTiny from '@/assets/isler/tiny-house-hiyap.webp';

// Tekerlek merkezleri, kamyon tuvalinin yüzdesi (scripts/truck-layers.py çıktısı)
const WHEELS = [
  { n: 't1', src: wT1, left: 10.73, top: 82.5, size: 5.69 },
  { n: 't2', src: wT2, left: 15.45, top: 82.5, size: 5.69 },
  { n: 't3', src: wT3, left: 20.08, top: 82.5, size: 5.69 },
  { n: 'r', src: wR, left: 47.64, top: 85.83, size: 8.78 },
  { n: 'f', src: wF, left: 75.45, top: 88.33, size: 9.27 },
];

const stops = [
  { key: 'yat', img: pYat, kicker: '01 · Marina', title: 'Marinadan kızağa', text: 'Yat, tekne, filika: gece gündüz indirir, bindirir, taşırız.', alt: 'Kurtuluş Vinç mavi Iveco çekici, gece marinada dorse üzerinde beyaz motoryat taşıyor' },
  { key: 'konteyner', img: pKonteyner, kicker: '02 · Şantiye', title: 'Şantiye evi geldi', text: 'Konteyner ve prefabrik yapıyı yerine kadar getirir, vinçle indiririz.', alt: 'Kurtuluş Vinç çekici ve hiyaplı kamyon, şantiyeye konteyner ofis taşıyor' },
  { key: 'filika', img: pFilika, kicker: '03 · Tersane', title: 'Deniz aracı, kara yolu', text: 'Filikadan sürat teknesine; askı, dengeleme ve bağlama bizde.', alt: 'Kırmızı kasalı kamyon üzerinde kayışlarla bağlanmış beyaz filika' },
  { key: 'zeytin', img: pZeytin, kicker: '04 · Bağ', title: 'Zeytin bağa döner', text: 'Yüzyıllık ağaçları köküyle söker, taşır, yeni yerine dikeriz.', alt: 'Kurtuluş Vinç çekici, dorsede köklü zeytin ağaçları taşıyor' },
  { key: 'tiny', img: pTiny, kicker: '05 · Villa', title: 'Ev, yerine kondu', text: 'Tiny house ve bungalov: hiyap ile tek seferde, tek araçla yerleştiririz.', alt: 'Hiyaplı beyaz kamyon, yeşil ahşap tiny house taşıyor' },
];
---
<section id="hero" class="relative isolate h-svh min-h-[620px] overflow-hidden bg-sky [--stop-w:min(86vw,400px)] [--stop-gap:12vw] [--track-pad:calc(50vw-var(--stop-w)/2)] md:[--stop-w:min(30vw,420px)] md:[--stop-gap:9vw]" aria-label="Kurtuluş Vinç: yol hikâyesi">
  <!-- gökyüzü, güneş, deniz ufku -->
  <div class="pointer-events-none absolute inset-0 -z-20 bg-gradient-to-b from-sky-2 via-sky to-paper-2" aria-hidden="true"></div>
  <div class="pointer-events-none absolute -right-[10%] top-[6%] -z-10 h-[38vw] w-[38vw] max-h-[360px] max-w-[360px] rounded-full bg-crane/35 blur-3xl" aria-hidden="true"></div>
  <div data-cloud class="pointer-events-none absolute left-[8%] top-[12%] -z-10 h-10 w-40 rounded-full bg-white/70 blur-2xl" aria-hidden="true"></div>
  <div data-cloud class="pointer-events-none absolute left-[55%] top-[22%] -z-10 h-8 w-56 rounded-full bg-white/60 blur-2xl" aria-hidden="true"></div>
  <div class="pointer-events-none absolute inset-x-0 bottom-[calc(var(--spacing-cta)+var(--road-h)+var(--truck-h)*0.55)] -z-10 h-[18svh] bg-gradient-to-b from-transparent via-sea/10 to-sea/15" aria-hidden="true" style="--road-h: 44px; --truck-h: 46vw;"></div>

  <!-- durak şeridi -->
  <div class="absolute inset-x-0 top-[4.5rem] bottom-[calc(var(--spacing-cta)+44px+46vw)] md:bottom-[calc(var(--spacing-cta)+52px+min(44vw,560px)*0.5)] md:top-20">
    <div data-track class="h-full">
      <!-- 0: giriş -->
      <article data-stop data-intro class="flex h-full flex-col justify-start pt-2 md:justify-center md:pt-0">
        <p class="mb-3 flex items-center gap-3 text-[11px] font-semibold uppercase tracking-[0.28em] text-sea">
          <span class="hazard-stripe inline-block h-px w-8" aria-hidden="true"></span>
          Çeşme · Alaçatı · Yarımada
        </p>
        <h1 class="text-[2.45rem] font-semibold leading-[1.02] tracking-[-0.03em] text-ink sm:text-5xl">
          Çeşme'nin yükünü<br /><span class="text-sea">biz taşırız.</span>
        </h1>
        <p class="mt-4 max-w-sm text-[15px] leading-relaxed text-ink-2 sm:text-lg">
          Vinç, hiyap, nakliye. Marinadan şantiyeye, bağdan villaya; yarımadanın her yoluna çıkarız.
        </p>
        <p class="mt-5 inline-flex items-center gap-2 text-sm font-semibold text-ink-3">
          <svg class="scroll-hint" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 5v14M5 12l7 7 7-7"/></svg>
          Kaydır, yola çıkalım
        </p>
      </article>

      {stops.map((s, i) => (
        <article data-stop class="flex flex-col gap-3">
          <div class="overflow-hidden rounded-2xl bg-white p-1.5 shadow-[0_24px_60px_-28px_rgba(23,32,51,.45)]">
            <Image src={s.img} alt={s.alt} widths={[420, 640, 900]} sizes="(min-width: 768px) 30vw, 86vw" loading={i === 0 ? 'eager' : 'lazy'} decoding="async" class="aspect-[4/3] h-auto w-full rounded-xl object-cover" />
          </div>
          <div class="px-1">
            <p class="text-[11px] font-semibold uppercase tracking-[0.25em] text-sea">{s.kicker}</p>
            <h2 class="mt-1 text-2xl font-semibold tracking-tight text-ink md:text-3xl">{s.title}</h2>
            <p class="mt-1 text-[15px] leading-relaxed text-ink-2 md:text-base">{s.text}</p>
          </div>
        </article>
      ))}

      <!-- son: CTA -->
      <article data-stop data-final class="flex h-full flex-col justify-start pt-2 md:justify-center md:pt-0">
        <p class="text-[11px] font-semibold uppercase tracking-[0.28em] text-sea">06 · Sıradaki durak</p>
        <h2 class="mt-2 text-[2.4rem] font-semibold leading-[1.02] tracking-[-0.03em] text-ink md:text-[2.75rem]">Neredesiniz?</h2>
        <p class="mt-3 max-w-sm text-[15px] leading-relaxed text-ink-2 md:text-lg">Konumu atın, ekip yola çıksın. Çeşme, Alaçatı, Urla, Karaburun, Seferihisar.</p>
        <div class="mt-5 flex flex-col gap-3 sm:flex-row">
          <a href={`tel:${company.phoneE164}`} class="tap inline-flex items-center justify-center gap-2 rounded-full bg-crane px-7 py-3.5 text-base font-bold text-ink shadow-[0_16px_40px_-14px_rgba(244,196,48,.9)] active:scale-[.98]">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M22 16.9v3a2 2 0 0 1-2.2 2 19.8 19.8 0 0 1-8.6-3.1 19.5 19.5 0 0 1-6-6A19.8 19.8 0 0 1 2.1 4.2 2 2 0 0 1 4.1 2h3a2 2 0 0 1 2 1.7c.1.9.4 1.9.7 2.8a2 2 0 0 1-.5 2.1L8 9.9a16 16 0 0 0 6 6l1.3-1.3a2 2 0 0 1 2.1-.4c.9.3 1.8.6 2.8.7a2 2 0 0 1 1.8 2z"/></svg>
            {company.phoneDisplay}
          </a>
          <a href={company.whatsapp} target="_blank" rel="noopener" class="tap inline-flex items-center justify-center gap-2 rounded-full border border-sea/30 bg-white px-7 py-3.5 text-base font-semibold text-sea active:bg-sky">Konum gönder</a>
        </div>
      </article>
    </div>
  </div>

  <!-- yol -->
  <div data-road class="absolute inset-x-0 bottom-[var(--spacing-cta)] h-[44px] overflow-hidden bg-ink-3/85 md:h-[52px]" aria-hidden="true">
    <div data-road-line class="absolute left-0 top-1/2 h-[3px] w-[calc(200vw+96px)] -translate-y-1/2 opacity-70"></div>
    <div class="absolute inset-x-0 top-0 h-px bg-white/25"></div>
  </div>

  <!-- kamyon -->
  <div data-truck class="pointer-events-none absolute bottom-[calc(var(--spacing-cta)+38px)] left-[2vw] w-[96vw] md:bottom-[calc(var(--spacing-cta)+44px)] md:left-[5vw] md:w-[min(44vw,560px)]" style="aspect-ratio: 1230 / 600;">
    <div class="absolute inset-x-[6%] bottom-[2%] h-[7%] rounded-[50%] bg-ink/30 blur-lg" aria-hidden="true"></div>
    <Image src={truck} alt="Kurtuluş Vinç'in mavi Iveco çekicisi, dorsesinde köklü zeytin ağaçlarıyla" widths={[560, 800, 1230]} sizes="(min-width: 768px) 44vw, 96vw" quality={68} loading="eager" fetchpriority="high" decoding="async" class="absolute inset-0 h-full w-full object-contain" />
    {WHEELS.map((w) => (
      <Image data-wheel src={w.src} alt="" widths={[120]} loading="eager" decoding="async" class="absolute h-auto" style={`left:${w.left}%; top:${w.top}%; width:${w.size}%; transform: translate(-50%, -50%);`} />
    ))}
  </div>
</section>

<script>
  import { initRoad } from '@/scripts/road';
  const start = () => initRoad();
  if ('requestIdleCallback' in window) requestIdleCallback(start, { timeout: 1200 });
  else setTimeout(start, 200);
</script>
