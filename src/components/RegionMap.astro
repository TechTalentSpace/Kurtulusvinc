---
/**
 * Çeşme yarımadasının stilize SVG haritası. Coğrafi doğruluk hedeflenmez;
 * ilçeler scroll'da sırayla yanar (IntersectionObserver + CSS gecikme).
 */
import districts from '@/data/districts.json';
// Stilize konumlar (viewBox 0 0 640 420)
const pos: Record<string, { x: number; y: number; anchor?: 'start' | 'end' | 'middle'; dy?: number }> = {
  cesme: { x: 104, y: 288, anchor: 'end', dy: -14 },
  ilica: { x: 152, y: 262, anchor: 'start', dy: -14 },
  alacati: { x: 176, y: 326, anchor: 'start', dy: 24 },
  urla: { x: 436, y: 232, anchor: 'start', dy: 24 },
  gulbahce: { x: 372, y: 196, anchor: 'end', dy: -14 },
  karaburun: { x: 262, y: 60, anchor: 'start', dy: -14 },
  seferihisar: { x: 470, y: 352, anchor: 'start', dy: 24 },
  guzelbahce: { x: 562, y: 250, anchor: 'end', dy: -14 },
};
const extra = [
  { name: 'Mordoğan', x: 280, y: 130 },
  { name: 'Dalyan', x: 96, y: 258 },
];
---
<div class="relative" data-region-map>
  <svg viewBox="0 0 640 420" class="block h-auto w-full" role="img" aria-labelledby="map-title">
    <title id="map-title">Çeşme yarımadası stilize haritası: Çeşme, Alaçatı, Ilıca, Urla, Gülbahçe, Karaburun, Seferihisar, Güzelbahçe</title>
    <defs>
      <pattern id="map-grid" width="24" height="24" patternUnits="userSpaceOnUse">
        <path d="M24 0H0v24" fill="none" stroke="#182028" stroke-width="1" />
      </pattern>
    </defs>
    <rect width="640" height="420" fill="url(#map-grid)" />
    <!-- deniz etiketi -->
    <text x="40" y="120" font-size="12" fill="#3a4654" letter-spacing="4" font-weight="700">EGE DENİZİ</text>
    <text x="500" y="140" font-size="12" fill="#3a4654" letter-spacing="4" font-weight="700">İZMİR KÖRFEZİ</text>
    <!-- kara -->
    <path
      d="M620 214 C 560 196, 500 186, 456 176 C 420 168, 392 172, 376 186 C 360 198, 340 176, 330 150 C 322 124, 312 92, 296 60 C 286 40, 274 24, 262 18 C 250 16, 238 34, 230 62 C 222 100, 220 140, 216 178 C 212 206, 190 224, 156 240 C 124 254, 96 262, 82 284 C 74 300, 86 322, 110 334 C 140 348, 170 352, 196 344 C 220 338, 246 350, 272 356 C 300 362, 330 352, 362 358 C 396 364, 428 380, 462 386 C 496 390, 530 366, 560 334 C 588 306, 612 270, 620 214 Z"
      fill="#11161d" stroke="#2f3a47" stroke-width="2" stroke-linejoin="round"
    />
    <!-- ana yol: İzmir - Çeşme -->
    <path d="M600 246 C 540 262, 480 250, 436 236 C 380 220, 300 260, 240 290 C 200 310, 160 296, 120 296" fill="none" stroke="#f5b301" stroke-width="2" stroke-dasharray="4 8" opacity=".55" />
    <!-- ikincil noktalar -->
    {extra.map((e) => (
      <g>
        <circle cx={e.x} cy={e.y} r="3" fill="#3a4654" />
        <text x={e.x + 8} y={e.y + 4} font-size="11" fill="#5c6a79" font-weight="600">{e.name}</text>
      </g>
    ))}
    <!-- ilçeler -->
    {districts.map((d, i) => {
      const p = pos[d.slug];
      return (
        <a href={`/${d.slug}-vinc-kiralama`} class="region-dot group focus:outline-none" data-district={d.slug} style={`--i:${i}`} aria-label={`${d.name} vinç kiralama`}>
          <circle cx={p.x} cy={p.y} r="16" fill="#f5b301" opacity="0" class="halo" />
          <circle cx={p.x} cy={p.y} r="6" fill="#0b0f14" stroke="#f5b301" stroke-width="3" class="dot" />
          <text x={p.x + (p.anchor === 'end' ? -12 : p.anchor === 'middle' ? 0 : 12)} y={p.y + (p.dy ?? 0)} text-anchor={p.anchor ?? 'start'} font-size="15" font-weight="800" fill="#ffffff" class="lbl" dominant-baseline={p.dy && p.dy < 0 ? 'auto' : 'middle'}>{d.name}</text>
        </a>
      );
    })}
  </svg>
</div>

<style>
  .region-dot .dot, .region-dot .lbl, .region-dot .halo { transition: opacity .5s ease, transform .5s ease, fill .3s ease; transition-delay: calc(var(--i) * 140ms); }
  .region-dot .dot { transform-box: fill-box; transform-origin: center; }
  .region-dot .halo { transform-box: fill-box; transform-origin: center; transform: scale(.4); }
  .js-motion .region-dot .dot { opacity: 0; transform: scale(.4); }
  .js-motion .region-dot .lbl { opacity: 0; }
  .js-motion [data-region-map].is-lit .region-dot .dot { opacity: 1; transform: scale(1); }
  .js-motion [data-region-map].is-lit .region-dot .lbl { opacity: 1; }
  .js-motion [data-region-map].is-lit .region-dot .halo { opacity: .22; transform: scale(1); }
  .region-dot:hover .dot, .region-dot:focus-visible .dot { fill: #f5b301; }
  .region-dot:hover .lbl, .region-dot:focus-visible .lbl { fill: #f5b301; }
  .region-dot:hover .halo, .region-dot:focus-visible .halo { opacity: .35 !important; transition-delay: 0s; }
  @media (prefers-reduced-motion: reduce) {
    .region-dot .dot, .region-dot .lbl, .region-dot .halo { transition: none; }
  }
</style>

<script>
  const map = document.querySelector('[data-region-map]');
  if (map && document.documentElement.classList.contains('js-motion')) {
    const io = new IntersectionObserver((entries) => {
      if (entries.some((e) => e.isIntersecting)) { map.classList.add('is-lit'); io.disconnect(); }
    }, { threshold: 0.35 });
    io.observe(map);
  }
</script>
