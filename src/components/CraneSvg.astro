---
/**
 * Mobil vinç silüeti — tamamen inline SVG.
 * Koordinat sistemi: viewBox 0 0 1000 700, zemin y=660.
 * Bom grubu (#boom) pivot (230,520) etrafında -35° döndürülmüş; içindeki
 * teleskopik segmentler (#boom-1..4) iç içe <g> olarak yerleşir ve yalnızca
 * x ekseninde translate ile uzar (path morph yok). Kanca (#hook) dünya
 * koordinatlarında, bom ucunu takip eder; son fazda #hook-body aşağı iner.
 *
 * Segment başına uzama: 130 birim (hero.ts içindeki EXT ile aynı olmalı).
 */
import company from '@/data/company.json';
const labels = company.services.map((s) => s.short);
// Her segmentin açıldıktan sonraki uç noktası (dünya koordinatı)
const COS = Math.cos((35 * Math.PI) / 180);
const SIN = Math.sin((35 * Math.PI) / 180);
const tipClosed = { x: 230 + 228 * COS, y: 520 - 228 * SIN };
const tips = [1, 2, 3, 4].map((k) => ({
  x: tipClosed.x + k * 130 * COS,
  y: tipClosed.y - k * 130 * SIN,
}));
const widths = [206, 244, 262, 286];
---
<svg
  viewBox="0 0 1000 700"
  class="block h-auto w-full"
  role="img"
  aria-labelledby="crane-title"
  id="crane-svg"
>
  <title id="crane-title">Teleskopik bomu uzayan mobil vinç çizimi; her kademede bir hizmet: {labels.join(', ')}</title>
  <defs>
    <linearGradient id="g-yellow" x1="0" y1="0" x2="0" y2="1">
      <stop offset="0" stop-color="#ffd34d" />
      <stop offset="1" stop-color="#e0a300" />
    </linearGradient>
    <linearGradient id="g-dark" x1="0" y1="0" x2="0" y2="1">
      <stop offset="0" stop-color="#2a3441" />
      <stop offset="1" stop-color="#131a22" />
    </linearGradient>
    <pattern id="p-hazard" width="16" height="16" patternUnits="userSpaceOnUse" patternTransform="rotate(-45)">
      <rect width="8" height="16" fill="#f5b301" />
      <rect x="8" width="8" height="16" fill="#0b0f14" />
    </pattern>
  </defs>

  <!-- zemin -->
  <line x1="0" y1="660" x2="1000" y2="660" stroke="#232c36" stroke-width="2" />
  <line x1="40" y1="680" x2="960" y2="680" stroke="#182028" stroke-width="1" stroke-dasharray="6 14" />

  <!-- dayama ayakları (outrigger) -->
  <g stroke="#0b0f14" stroke-width="3">
    <rect x="18" y="580" width="110" height="18" fill="#c98f00" />
    <rect x="24" y="598" width="16" height="50" fill="#2a3441" />
    <rect x="8" y="646" width="48" height="12" rx="2" fill="#2a3441" />
    <rect x="560" y="580" width="110" height="18" fill="#c98f00" />
    <rect x="648" y="598" width="16" height="50" fill="#2a3441" />
    <rect x="632" y="646" width="48" height="12" rx="2" fill="#2a3441" />
  </g>

  <!-- hidrolik kaldırma silindiri (bom arkasında) -->
  <line x1="372" y1="562" x2="345" y2="440" stroke="#2a3441" stroke-width="18" stroke-linecap="round" />
  <line x1="372" y1="562" x2="352" y2="472" stroke="#8b96a3" stroke-width="8" stroke-linecap="round" />

  <!-- şasi -->
  <rect x="70" y="556" width="540" height="56" rx="8" fill="url(#g-dark)" stroke="#0b0f14" stroke-width="3" />
  <rect x="70" y="600" width="540" height="12" fill="url(#p-hazard)" opacity=".9" />

  <!-- sürücü kabini (ön, sağ) -->
  <path d="M500 556v-72a12 12 0 0 1 12-12h70l30 34v50z" fill="url(#g-yellow)" stroke="#0b0f14" stroke-width="3" stroke-linejoin="round" />
  <path d="M514 486h60l22 26v20h-82z" fill="#0b0f14" />
  <path d="M520 492h50l14 16v10h-64z" fill="#1e2a38" />
  <rect x="604" y="536" width="26" height="14" rx="3" fill="#f2542d" />

  <!-- karşı ağırlık (arka, sol) -->
  <rect x="112" y="486" width="86" height="72" rx="4" fill="#2a3441" stroke="#0b0f14" stroke-width="3" />
  <rect x="112" y="486" width="86" height="12" fill="url(#p-hazard)" />

  <!-- üst yapı + operatör kabini -->
  <rect x="150" y="470" width="190" height="90" rx="10" fill="url(#g-yellow)" stroke="#0b0f14" stroke-width="3" />
  <path d="M262 478h60a10 10 0 0 1 10 10v44h-70z" fill="#0b0f14" />
  <path d="M268 484h50a6 6 0 0 1 6 6v36h-56z" fill="#1e2a38" />
  <circle cx="230" cy="536" r="10" fill="#0b0f14" />

  <!-- tekerlekler -->
  <g>
    {[130, 232, 436, 538].map((cx) => (
      <g>
        <circle cx={cx} cy="620" r="40" fill="#0b0f14" stroke="#232c36" stroke-width="3" />
        <circle cx={cx} cy="620" r="20" fill="#2a3441" />
        <circle cx={cx} cy="620" r="7" fill="#8b96a3" />
      </g>
    ))}
  </g>

  <!-- bom: pivot etrafında -35° -->
  <g id="boom" transform="translate(230 520) rotate(-35)">
    <!-- taban bom -->
    <rect x="-44" y="-15" width="266" height="30" rx="5" fill="url(#g-yellow)" stroke="#0b0f14" stroke-width="3" />
    <rect x="-44" y="-15" width="266" height="6" fill="#ffe28a" opacity=".6" />
    <circle cx="0" cy="0" r="9" fill="#0b0f14" />
    <circle cx="0" cy="0" r="4" fill="#8b96a3" />

    <!-- teleskopik segmentler; her biri bir öncekinin içinde -->
    <g id="boom-1" style="will-change: transform">
      <rect x="18" y="-11.5" width="206" height="23" rx="4" fill="#f5b301" stroke="#0b0f14" stroke-width="2.5" />
      <g id="boom-2" style="will-change: transform">
        <rect x="38" y="-9" width="188" height="18" rx="3.5" fill="#ffc627" stroke="#0b0f14" stroke-width="2.5" />
        <g id="boom-3" style="will-change: transform">
          <rect x="58" y="-6.5" width="170" height="13" rx="3" fill="#f5b301" stroke="#0b0f14" stroke-width="2.5" />
          <g id="boom-4" style="will-change: transform">
            <rect x="78" y="-4.5" width="152" height="9" rx="2.5" fill="#ffd34d" stroke="#0b0f14" stroke-width="2" />
            <!-- bom başı / makara -->
            <circle cx="230" cy="0" r="9" fill="#2a3441" stroke="#0b0f14" stroke-width="2" />
            <circle cx="230" cy="0" r="3" fill="#8b96a3" />
          </g>
        </g>
      </g>
    </g>
  </g>

  <!-- kanca: dünya koordinatları; bom ucunu takip eder -->
  <g id="hook" transform={`translate(${tipClosed.x.toFixed(1)} ${tipClosed.y.toFixed(1)})`} style="will-change: transform">
    <line id="cable" x1="0" y1="0" x2="0" y2="40" stroke="#8b96a3" stroke-width="2.5" style="transform-origin: 0 0; will-change: transform" />
    <g id="hook-body" transform="translate(0 40)" style="will-change: transform">
      <rect x="-11" y="0" width="22" height="26" rx="4" fill="#2a3441" stroke="#0b0f14" stroke-width="2" />
      <rect x="-11" y="10" width="22" height="6" fill="url(#p-hazard)" />
      <path d="M0 26v10c0 12 -18 12 -18 0" fill="none" stroke="#f5b301" stroke-width="6" stroke-linecap="round" />
    </g>
  </g>

  <!-- hizmet etiketleri: her segment açıldığında görünür -->
  {tips.map((t, i) => {
    const w = widths[i];
    const x = t.x - 30; // sağ kenar bom ucunun biraz solunda (kanca ile çakışmasın)
    const y = t.y + 30;
    return (
      <g transform={`translate(${x.toFixed(1)} ${y.toFixed(1)})`}>
        <g data-label={i + 1} class="hero-label" style="will-change: transform, opacity">
          <rect x={-w} y="0" width={w} height="46" rx="23" fill="#11161d" stroke="#232c36" stroke-width="2" />
          <circle cx={-w + 23} cy="23" r="13" fill="#f5b301" />
          <text x={-w + 23} y="23" text-anchor="middle" dominant-baseline="central" font-size="17" font-weight="800" fill="#0b0f14">{i + 1}</text>
          <text x="-18" y="23" text-anchor="end" dominant-baseline="central" font-size="24" font-weight="700" fill="#ffffff">{labels[i]}</text>
        </g>
      </g>
    );
  })}
</svg>
