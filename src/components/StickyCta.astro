---
import company from '@/data/company.json';
---
<div
  class="fixed inset-x-0 bottom-0 z-50 border-t border-line bg-ink/95 backdrop-blur supports-[backdrop-filter]:bg-ink/80"
  style="padding-bottom: env(safe-area-inset-bottom, 0px);"
  aria-label="Hızlı iletişim"
>
  <div class="mx-auto grid h-cta max-w-3xl grid-cols-2">
    <a
      href={`tel:${company.phoneE164}`}
      class="tap flex items-center justify-center gap-2 bg-crane font-bold tracking-wide text-ink active:bg-crane-2"
      aria-label={`Ara: ${company.phoneDisplay}`}
    >
      <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <path d="M22 16.9v3a2 2 0 0 1-2.2 2 19.8 19.8 0 0 1-8.6-3.1 19.5 19.5 0 0 1-6-6A19.8 19.8 0 0 1 2.1 4.2 2 2 0 0 1 4.1 2h3a2 2 0 0 1 2 1.7c.1.9.4 1.9.7 2.8a2 2 0 0 1-.5 2.1L8 9.9a16 16 0 0 0 6 6l1.3-1.3a2 2 0 0 1 2.1-.4c.9.3 1.8.6 2.8.7a2 2 0 0 1 1.8 2z"/>
      </svg>
      <span>Ara</span>
    </a>
    <a
      href={company.whatsapp}
      target="_blank"
      rel="noopener"
      class="tap flex items-center justify-center gap-2 bg-ink-3 font-bold tracking-wide text-fog active:bg-line"
      aria-label="WhatsApp ile yaz"
    >
      <svg width="20" height="20" viewBox="0 0 24 24" fill="#25d366" aria-hidden="true">
        <path d="M12 2a10 10 0 0 0-8.6 15.1L2 22l5-1.3A10 10 0 1 0 12 2zm0 18.2a8.2 8.2 0 0 1-4.2-1.1l-.3-.2-3 .8.8-2.9-.2-.3A8.2 8.2 0 1 1 12 20.2zm4.5-6.1c-.2-.1-1.5-.7-1.7-.8-.2-.1-.4-.1-.6.1l-.8.9c-.1.2-.3.2-.5.1a6.7 6.7 0 0 1-3.3-2.9c-.3-.4.3-.4.7-1.3.1-.2 0-.3 0-.4l-.8-1.8c-.2-.5-.4-.4-.6-.4h-.5a1 1 0 0 0-.7.3 3 3 0 0 0-.9 2.2 5.2 5.2 0 0 0 1.1 2.8c.1.2 1.9 2.9 4.6 4 1.7.7 2.4.8 3.2.7.5-.1 1.5-.6 1.7-1.2.2-.6.2-1.1.1-1.2l-.5-.3z"/>
      </svg>
      <span>WhatsApp</span>
    </a>
  </div>
</div>
