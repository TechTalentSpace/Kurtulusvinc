---
import '@/styles/global.css';
import company from '@/data/company.json';
import Seo from '@/components/Seo.astro';
import StickyCta from '@/components/StickyCta.astro';

interface Props {
  title: string;
  description: string;
  path: string;
  ogImage?: string;
}
const { title, description, path, ogImage } = Astro.props;
const year = new Date().getFullYear();
const icons = {
  instagram: '<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="2" y="2" width="20" height="20" rx="5"/><circle cx="12" cy="12" r="4"/><circle cx="17.5" cy="6.5" r="1" fill="currentColor"/></svg>',
  facebook: '<svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M13.5 22v-8h2.7l.4-3.2h-3.1V8.8c0-.9.3-1.6 1.6-1.6h1.7V4.4c-.3 0-1.3-.1-2.5-.1-2.5 0-4.1 1.5-4.1 4.2v2.3H7.4V14h2.8v8z"/></svg>',
  whatsapp: '<svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 2a10 10 0 0 0-8.6 15.1L2 22l5-1.3A10 10 0 1 0 12 2zm0 18.2a8.2 8.2 0 0 1-4.2-1.1l-.3-.2-3 .8.8-2.9-.2-.3A8.2 8.2 0 1 1 12 20.2zm4.5-6.1c-.2-.1-1.5-.7-1.7-.8-.2-.1-.4-.1-.6.1l-.8.9c-.1.2-.3.2-.5.1a6.7 6.7 0 0 1-3.3-2.9c-.3-.4.3-.4.7-1.3.1-.2 0-.3 0-.4l-.8-1.8c-.2-.5-.4-.4-.6-.4h-.5a1 1 0 0 0-.7.3 3 3 0 0 0-.9 2.2 5.2 5.2 0 0 0 1.1 2.8c.1.2 1.9 2.9 4.6 4 1.7.7 2.4.8 3.2.7.5-.1 1.5-.6 1.7-1.2.2-.6.2-1.1.1-1.2l-.5-.3z"/></svg>',
};
// Sadece dolu olan sosyal bağlantılar gösterilir (company.json > social)
const socials = [
  { key: 'whatsapp', label: 'WhatsApp', href: company.whatsapp, icon: icons.whatsapp },
  { key: 'instagram', label: 'Instagram', href: company.social.instagram, icon: icons.instagram },
  { key: 'facebook', label: 'Facebook', href: company.social.facebook, icon: icons.facebook },
].filter((so) => so.href);
const nav = [
  { href: '/#hizmetler', label: 'Hizmetler' },
  { href: '/#bolge', label: 'Bölge' },
  { href: '/sss', label: 'SSS' },
  { href: '/iletisim', label: 'İletişim' },
];
---
<!doctype html>
<html lang="tr" dir="ltr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="theme-color" content="#e3eef8" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <link rel="preload" href="/fonts/inter-tight-var.woff2" as="font" type="font/woff2" crossorigin />
    <script is:inline>
      // Hareket animasyonları için erken işaret: reduced-motion ise eklenmez, her şey statik görünür
      if (!matchMedia('(prefers-reduced-motion: reduce)').matches) document.documentElement.classList.add('js-motion');
    </script>
    <link rel="sitemap" href="/sitemap-index.xml" />
    <Seo title={title} description={description} path={path} ogImage={ogImage} />
    <slot name="head" />
  </head>
  <body class="min-h-svh">
    <a href="#icerik" class="sr-only focus:not-sr-only focus:fixed focus:left-4 focus:top-4 focus:z-[60] focus:rounded focus:bg-crane focus:px-4 focus:py-2 focus:font-bold focus:text-ink">İçeriğe geç</a>

    <header class="absolute inset-x-0 top-0 z-40">
      <div class="container-x flex h-16 items-center justify-between">
        <a href="/" class="tap flex items-center gap-2.5 font-extrabold tracking-tight text-ink" title="Ana sayfa">
          <svg width="30" height="30" viewBox="0 0 32 32" aria-hidden="true">
            <rect width="32" height="32" rx="8" fill="#1d3f9f"/>
            <path d="M7 24h18M9 24V13l12-6M21 7v17M21 7l4 3" stroke="#f4c430" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" fill="none"/>
            <circle cx="12" cy="17" r="1.6" fill="#f4c430"/>
          </svg>
          <span class="text-[17px] leading-none tracking-tight text-ink">Kurtuluş<span class="text-sea"> Vinç</span></span>
        </a>
        <nav aria-label="Ana menü" class="hidden gap-6 text-sm font-semibold text-ink-2 md:flex">
          {nav.map((n) => <a class="tap inline-flex items-center hover:text-ink" href={n.href}>{n.label}</a>)}
        </nav>
        <a href={`tel:${company.phoneE164}`} class="tap inline-flex items-center rounded-full bg-crane px-4 text-sm font-bold text-ink shadow-sm hover:bg-crane-2">
          {company.phoneDisplay}
        </a>
      </div>
    </header>

    <main id="icerik">
      <slot />
    </main>

    <footer class="border-t border-line bg-paper-2">
      <div class="hazard-stripe h-px opacity-70" aria-hidden="true"></div>
      <div class="container-x grid gap-8 py-12 md:grid-cols-3">
        <div>
          <p class="text-lg font-extrabold text-ink">{company.name}</p>
          <address class="mt-2 not-italic text-sm text-ink-3">
            {company.areaLabel}<br />
            <!-- TODO: sokak adresi doğrulanınca buraya ve company.json'a eklenecek -->
            <a class="tap inline-flex items-center font-semibold text-ink-2 hover:text-sea" href={`tel:${company.phoneE164}`}>{company.phoneDisplay}</a>
          </address>
        </div>
        <nav aria-label="Hizmetler" class="text-sm">
          <p class="mb-2 font-bold text-ink">Hizmetler</p>
          <ul class="space-y-1">
            {company.services.map((s) => <li><a class="tap inline-flex items-center text-ink-3 hover:text-sea" href={`/hizmetler/${s.slug}`}>{s.name}</a></li>)}
          </ul>
        </nav>
        <nav aria-label="Bölgeler" class="text-sm">
          <p class="mb-2 font-bold text-ink">Vinç Kiralama Bölgeleri</p>
          <ul class="grid grid-cols-2 gap-x-4 gap-y-1">
            {['cesme','alacati','ilica','urla','gulbahce','karaburun','seferihisar','guzelbahce'].map((slug) => {
              const name = {cesme:'Çeşme',alacati:'Alaçatı',ilica:'Ilıca',urla:'Urla',gulbahce:'Gülbahçe',karaburun:'Karaburun',seferihisar:'Seferihisar',guzelbahce:'Güzelbahçe'}[slug];
              return <li><a class="tap inline-flex items-center text-ink-3 hover:text-sea" href={`/${slug}-vinc-kiralama`}>{name}</a></li>;
            })}
          </ul>
        </nav>
      </div>
      <div class="container-x flex flex-wrap items-center justify-between gap-2 border-t border-line py-4 text-xs text-ink-3">
        <span>© {year} {company.name}. Tüm hakları saklıdır.</span>
        <span class="flex gap-4"><a class="hover:text-sea" href="/sss">SSS</a><a class="hover:text-sea" href="/iletisim">İletişim</a></span>
      </div>
    </footer>

    <StickyCta />
    <script>
      // Reveal animasyonları; js-motion sınıfı head'de erken eklenir
      if (document.documentElement.classList.contains('js-motion')) {
        const io = new IntersectionObserver((entries) => {
          for (const e of entries) if (e.isIntersecting) { e.target.classList.add('is-in'); io.unobserve(e.target); }
        }, { rootMargin: '0px 0px -10% 0px' });
        document.querySelectorAll('[data-reveal]').forEach((el) => io.observe(el));
      }
    </script>
  </body>
</html>
