---
import Base from '@/layouts/Base.astro';
import JsonLd from '@/components/JsonLd.astro';
import company from '@/data/company.json';
import { worlds } from '@/data/worlds';

const title = 'Kurtuluş Vinç — Çeşme Alaçatı Vinç, Tekne ve Nakliye';
const description = 'Çeşme ve Alaçatı\'da vinç, hiyap ve nakliye: tekne indirme-bindirme, zeytin ağacı ve tiny house nakli, araç kurtarma. Yarımadanın her yoluna. 0532 466 38 74';
---
<Base title={title} description={description} path="/">
  <Fragment slot="head">
    <JsonLd kind="home" path="/" />
    <link rel="preload" href="/models/tekne.glb" as="fetch" crossorigin />
  </Fragment>

  <div id="stage" aria-hidden="true"><canvas id="stage-canvas"></canvas></div>
  <div class="grain" aria-hidden="true"></div>

  <!-- Yükleyici -->
  <div data-loader class="hud fade inset-0 z-30 flex flex-col items-center justify-center bg-paper">
    <p class="hud-label text-ink-3">Kurtuluş Vinç</p>
    <p class="mt-6 font-mono text-5xl font-medium tabular-nums text-ink"><span data-loader-pct>000</span></p>
    <div class="mt-6 h-px w-40 bg-line"><div data-loader-bar class="loader-bar h-px w-full origin-left scale-x-0 bg-ink transition-transform duration-300"></div></div>
    <p class="hud-label mt-6 text-ink-3">Sahne hazırlanıyor</p>
  </div>

  <!-- Lobi: seçim -->
  <section data-lobby class="hud fade is-hidden inset-x-0 bottom-0 top-0 pointer-events-none">
    <div class="container-x flex h-full flex-col justify-end pb-10 md:justify-center md:pb-0">
      <div class="pointer-events-auto max-w-md">
        <p data-lobby-eyebrow class="hud-label text-sea">{worlds[0].eyebrow}</p>
        <h1 data-lobby-title class="mt-3 text-[2.6rem] font-medium leading-[1.02] tracking-[-0.03em] text-ink md:text-6xl">{worlds[0].headline}</h1>
        <p data-lobby-intro class="mt-4 max-w-sm text-[15px] leading-relaxed text-ink-2 md:text-base">{worlds[0].intro}</p>
        <div class="mt-6 flex items-center gap-3">
          <button data-enter type="button" class="btn-solid">{worlds[0].label} dünyasına gir</button>
        </div>
      </div>
      <div class="pointer-events-auto mt-8 flex gap-2 md:absolute md:bottom-10 md:left-1/2 md:mt-0 md:-translate-x-1/2" role="tablist" aria-label="Dünyalar">
        {worlds.map((w, i) => (
          <button data-tab type="button" role="tab" aria-selected={i === 0 ? 'true' : 'false'} class="hud-label rounded-full border border-transparent px-4 py-2 text-ink-3 transition aria-selected:border-line aria-selected:text-ink">{w.label}</button>
        ))}
      </div>
    </div>
  </section>
  <p data-hint class="hud hud-label fade is-hidden bottom-4 left-1/2 flex -translate-x-1/2 items-center gap-4 whitespace-nowrap text-ink-3 md:bottom-4 md:right-8 md:left-auto md:translate-x-0"><span>Kaydır · Seç</span><button data-text-version type="button" class="pointer-events-auto underline-offset-4 hover:text-ink hover:underline">Metin sürümü ↓</button></p>

  <!-- Dünya paneli -->
  <section data-world class="hud fade is-hidden inset-x-0 bottom-0 pointer-events-none md:top-0">
    <div class="container-x flex h-full flex-col justify-end pb-8 md:grid md:grid-cols-12 md:items-center md:pb-0">
      <div class="pointer-events-auto rounded-2xl bg-paper/70 p-5 backdrop-blur-md md:col-span-5 md:rounded-none md:bg-transparent md:p-0 md:backdrop-blur-0">
        <button data-back type="button" class="hud-label mb-4 inline-flex items-center gap-2 text-ink-3 hover:text-ink"><span aria-hidden="true">←</span> Geri</button>
        <p data-world-eyebrow class="hud-label text-sea"></p>
        <h2 data-world-headline class="mt-2 text-3xl font-medium tracking-[-0.03em] text-ink md:text-5xl"></h2>
        <div class="mt-5 flex items-center gap-2" aria-label="Adımlar">
          {[0, 1, 2].map((k) => <button data-dot type="button" aria-label={`Adım ${k + 1}`} class={`h-1.5 w-8 rounded-full bg-line transition ${k === 0 ? 'bg-ink' : ''}`}></button>)}
        </div>
        <h3 data-step-title class="mt-4 text-lg font-medium text-ink md:text-xl"></h3>
        <p data-step-text class="mt-2 max-w-md text-[15px] leading-relaxed text-ink-2"></p>
        <div class="mt-5 flex flex-wrap items-center gap-3">
          <button data-next type="button" class="btn-ghost">Devam</button>
          <a href={`tel:${company.phoneE164}`} class="btn-solid">Ara · {company.phoneDisplay}</a>
        </div>
        <div data-world-services class="mt-5 hidden text-sm md:block"></div>
      </div>
    </div>
  </section>

  <!-- Arama motorları ve JS'siz ziyaret için içerik -->
  <div id="icerik-metin" class="relative z-10 mt-[100svh] bg-paper">
    <div class="container-x py-16 md:py-24">
      {worlds.map((w) => (
        <article id={w.key} class="grid gap-4 border-t border-line py-10 md:grid-cols-12">
          <div class="md:col-span-4"><p class="hud-label text-sea">{w.eyebrow}</p><h2 class="mt-2 text-2xl font-medium text-ink">{w.headline}</h2></div>
          <div class="md:col-span-8">
            <p class="text-ink-2">{w.intro}</p>
            <ul class="mt-4 grid gap-3 md:grid-cols-3">{w.steps.map((s) => <li><p class="font-medium text-ink">{s.title}</p><p class="mt-1 text-sm text-ink-3">{s.text}</p></li>)}</ul>
            <p class="mt-4 text-sm">{w.services.map((s) => <a class="mr-4 text-ink-2 underline-offset-4 hover:text-ink hover:underline" href={s.href}>{s.name}</a>)}</p>
          </div>
        </article>
      ))}
      <div class="border-t border-line py-10">
        <p class="hud-label text-sea">Bölgeler</p>
        <p class="mt-3 flex flex-wrap gap-x-5 gap-y-2 text-sm">
          {['cesme','alacati','ilica','urla','gulbahce','karaburun','seferihisar','guzelbahce'].map((s) => <a class="text-ink-2 hover:text-ink" href={`/${s}-vinc-kiralama`}>{ {cesme:'Çeşme',alacati:'Alaçatı',ilica:'Ilıca',urla:'Urla',gulbahce:'Gülbahçe',karaburun:'Karaburun',seferihisar:'Seferihisar',guzelbahce:'Güzelbahçe'}[s] } vinç kiralama</a>)}
        </p>
      </div>
    </div>
  </div>

  <script>
    import { initUI } from '@/scripts/stage/ui';
    initUI();
  </script>
</Base>
