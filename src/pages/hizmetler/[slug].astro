---
import Base from '@/layouts/Base.astro';
import JsonLd from '@/components/JsonLd.astro';
import company from '@/data/company.json';
import districts from '@/data/districts.json';

export function getStaticPaths() {
  return company.services.map((service) => ({ params: { slug: service.slug }, props: { service } }));
}
const { service } = Astro.props;
const path = `/hizmetler/${service.slug}`;
const title = `${service.name} | Kurtuluş Vinç Çeşme`;
const description = `${service.summary} Ara: ${company.phoneDisplay}`.slice(0, 155);
const others = company.services.filter((s) => s.slug !== service.slug);
---
<Base title={title} description={description} path={path}>
  <Fragment slot="head"><JsonLd kind="service" path={path} service={service} /></Fragment>

  <section class="grid-lines border-b border-line pt-28 pb-12 md:pt-36 md:pb-16">
    <div class="container-x">
      <nav aria-label="Breadcrumb" class="mb-4 text-xs text-ink-3"><a href="/" class="hover:text-sea">Ana Sayfa</a> / <a href="/#hizmetler" class="hover:text-sea">Hizmetler</a> / <span class="text-ink-2">{service.short}</span></nav>
      <h1 class="text-4xl font-semibold tracking-tight text-ink md:text-5xl">{service.name}</h1>
      <p class="mt-4 max-w-2xl text-lg text-ink-2">{service.summary}</p>
      <div class="mt-6 flex flex-wrap gap-3">
        <a href={`tel:${company.phoneE164}`} class="tap inline-flex items-center rounded-full bg-crane px-6 py-3 font-extrabold text-ink">{company.phoneDisplay}</a>
        <a href={company.whatsapp} target="_blank" rel="noopener" class="tap inline-flex items-center rounded-full border border-safe-deep px-6 py-3 font-bold text-safe-deep">WhatsApp</a>
      </div>
    </div>
  </section>

  <section class="container-x grid gap-10 py-14 md:grid-cols-2">
    <div>
      <h2 class="text-2xl font-semibold text-ink">Neler yapıyoruz</h2>
      <ul class="mt-4 space-y-2">
        {service.bullets.map((b) => <li class="flex gap-3 text-ink-2"><span class="mt-2 h-2 w-2 shrink-0 rounded-sm bg-crane" aria-hidden="true"></span>{b}</li>)}
      </ul>
      <p class="mt-6 rounded-lg border border-line bg-paper-2 p-4 text-sm text-ink-3"><!-- TODO --> {service.capacityNote}</p>
    </div>
    <div>
      <h2 class="text-2xl font-semibold text-ink">Tipik işler</h2>
      <ul class="mt-4 grid gap-3">
        {service.useCases.map((u) => <li class="rounded-xl border border-line px-4 py-3 text-ink-2">{u}</li>)}
      </ul>
    </div>
  </section>

  <section class="border-t border-line bg-paper-2 py-14">
    <div class="container-x">
      <h2 class="text-2xl font-semibold text-ink">Bu hizmeti verdiğimiz ilçeler</h2>
      <ul class="mt-4 flex flex-wrap gap-2">
        {districts.map((d) => <li><a href={`/${d.slug}-vinc-kiralama`} class="tap inline-flex items-center rounded-full border border-line px-4 text-sm font-semibold text-ink-2 hover:border-crane hover:text-sea">{d.name}</a></li>)}
      </ul>
      <h2 class="mt-10 text-2xl font-semibold text-ink">Diğer hizmetler</h2>
      <ul class="mt-4 grid gap-3 sm:grid-cols-3">
        {others.map((o) => <li><a href={`/hizmetler/${o.slug}`} class="block rounded-xl border border-line p-4 font-bold text-ink hover:border-crane">{o.name}<span class="mt-1 block text-sm font-normal text-ink-3">{o.tagline}</span></a></li>)}
      </ul>
    </div>
  </section>
</Base>
