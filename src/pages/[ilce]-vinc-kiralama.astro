---
import Base from '@/layouts/Base.astro';
import JsonLd from '@/components/JsonLd.astro';
import company from '@/data/company.json';
import districts from '@/data/districts.json';

export function getStaticPaths() {
  return districts.map((district) => ({ params: { ilce: district.slug }, props: { district } }));
}
const { district } = Astro.props;
const path = `/${district.slug}-vinc-kiralama`;
const others = districts.filter((d) => d.slug !== district.slug);
---
<Base title={district.title} description={district.description} path={path}>
  <Fragment slot="head"><JsonLd kind="district" path={path} district={district} /></Fragment>

  <section class="grid-lines border-b border-line pt-28 pb-12 md:pt-36 md:pb-16">
    <div class="container-x">
      <nav aria-label="Breadcrumb" class="mb-4 text-xs text-fog-2"><a href="/" class="hover:text-crane">Ana Sayfa</a> / <span class="text-fog">{district.name}</span></nav>
      <h1 class="text-4xl font-extrabold text-white md:text-5xl">{district.name} Vinç Kiralama</h1>
      <p class="mt-4 max-w-2xl text-lg text-fog">{district.intro}</p>
      <div class="mt-6 flex flex-wrap gap-3">
        <a href={`tel:${company.phoneE164}`} class="tap inline-flex items-center rounded-full bg-crane px-6 py-3 font-extrabold text-ink">{company.phoneDisplay}</a>
        <a href={company.whatsapp} target="_blank" rel="noopener" class="tap inline-flex items-center rounded-full border border-safe px-6 py-3 font-bold text-safe">WhatsApp</a>
      </div>
    </div>
  </section>

  <section class="container-x grid gap-10 py-14 md:grid-cols-12">
    <article class="space-y-5 text-fog md:col-span-7">
      {district.content.map((p) => <p>{p}</p>)}
    </article>
    <aside class="md:col-span-5">
      <div class="rounded-2xl border border-line bg-ink-2 p-6">
        <h2 class="text-lg font-extrabold text-white">{district.name}'de sık yaptığımız işler</h2>
        <ul class="mt-3 space-y-2">
          {district.jobs.map((j) => <li class="flex gap-3 text-sm text-fog"><span class="mt-1.5 h-2 w-2 shrink-0 rounded-sm bg-crane" aria-hidden="true"></span>{j}</li>)}
        </ul>
        <p class="mt-4 text-xs text-fog-2">Bölgeler: {district.landmarks.join(' · ')}</p>
      </div>
      <div class="mt-4 rounded-2xl border border-line p-6">
        <h2 class="text-lg font-extrabold text-white">Hizmetler</h2>
        <ul class="mt-3 space-y-1">
          {company.services.map((s) => <li><a class="tap inline-flex items-center text-sm font-semibold text-fog hover:text-crane" href={`/hizmetler/${s.slug}`}>{s.name}</a></li>)}
        </ul>
      </div>
    </aside>
  </section>

  <section class="border-t border-line bg-ink-2 py-12">
    <div class="container-x">
      <h2 class="text-xl font-extrabold text-white">Komşu ilçeler</h2>
      <ul class="mt-4 flex flex-wrap gap-2">
        {others.map((d) => <li><a href={`/${d.slug}-vinc-kiralama`} class="tap inline-flex items-center rounded-full border border-line px-4 text-sm font-semibold text-fog hover:border-crane hover:text-crane">{d.name} Vinç Kiralama</a></li>)}
      </ul>
    </div>
  </section>
</Base>
